# Backend environment (copy to .env — never commit real secrets).

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name

PORT=5050
JWT_SECRET=replace_with_long_random_secret

IMAGE_STORAGE=path
URL_ENCRYPT_SALT=replace_with_random_salt

RECAPTCHA_SECRET_KEY=your_recaptcha_secret

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_app_password
SMTP_FROM="Spade Community <noreply@example.com>"

# 64-char hex keys used by cryptoHelper (must match frontend encryption contract)
ENCRYPTION_KEY1=replace_with_64_char_hex
ENCRYPTION_KEY2=replace_with_64_char_hex

BASE_URL=http://localhost:5173
CLIENT_BASE_URL=http://localhost:5174
